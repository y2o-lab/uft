{
  "name": "uft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:record": "PLAYWRIGHT_VIDEO=1 playwright test",
    "pages:deploy": "wrangler pages deploy dist --project-name uft"
  },
  "dependencies": {
    "@aws-icons/svg": "4.1.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@firecrawl/anydoc-wasm": "0.1.9",
    "@lucide/svelte": "1.52.0",
    "@sqlite.org/sqlite-wasm": "3.51.2-build9",
    "@xyflow/svelte": "1.7.0",
    "fflate": "0.8.3",
    "mermaid": "11.17.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "svelte": "5.57.2",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/turndown": "5.0.6",
    "jsdom": "26.1.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "wrangler": "4.148.0"
  }
}
