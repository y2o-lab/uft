{
  "name": "uft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pages:deploy": "wrangler pages deploy dist --project-name uft"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@firecrawl/anydoc-wasm": "0.1.9",
    "@sqlite.org/sqlite-wasm": "3.51.2-build9",
    "@xyflow/svelte": "1.6.3",
    "fflate": "0.8.3",
    "mermaid": "11.16.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "svelte": "5.56.9",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tsconfig/svelte": "5.0.8",
    "jsdom": "26.1.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.123.0"
  }
}
